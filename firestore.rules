rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Points de l'utilisateur : lisibles par tout compte connecté (affichage profil),
    // modifiables uniquement par leur propriétaire, et seulement pour augmenter le total
    // (un signalement rapporte des points, il ne peut jamais en retirer).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.points is int
        && request.resource.data.points >= 0;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.points is int
        && request.resource.data.points >= resource.data.points;
    }

    match /affluence_zones/{zoneId} {
      allow read: if true;
      allow write: if false;

      // Un signalement est immuable une fois créé : pas de update/delete.
      match /reports/{reportId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.level is int
          && request.resource.data.level >= 0
          && request.resource.data.level <= 5
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Agrégats horaires (moyenne glissante) : mis à jour de façon incrémentale par
      // n'importe quel utilisateur connecté au moment où il signale l'affluence.
      match /hourly_stats/{bucketId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.resource.data.avgLevel is number
          && request.resource.data.avgLevel >= 0
          && request.resource.data.avgLevel <= 5
          && request.resource.data.sampleCount is int
          && request.resource.data.sampleCount >= 0;
      }
    }

    // Spots ajoutés par les utilisateurs (ex. piscines, absentes d'OSM) quand
    // ils ne sont près d'aucun spot connu. Publics en lecture (affichés sur la
    // carte de tout le monde), immuables une fois créés.
    match /community_spots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.type is int
        && request.resource.data.type >= 0
        && request.resource.data.type <= 3
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Commentaires libres postés sur un spot. Publics en lecture pour les
    // connectés, immuables une fois créés (pas d'édition/suppression pour
    // l'instant — même choix que les signalements d'affluence).
    match /spot_comments/{zoneId} {
      allow read: if true;
      allow write: if false;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() > 0
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
